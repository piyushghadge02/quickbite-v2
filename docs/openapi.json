            "type": "object",
            "title": "Orders By Status"
          },
          "outbox_pending": {
            "type": "integer",
            "title": "Outbox Pending"
          },
          "outbox_scheduled": {
            "type": "integer",
            "title": "Outbox Scheduled"
          },
          "retries_scheduled": {
            "type": "integer",
            "title": "Retries Scheduled"
          },
          "quarantine_total": {
            "type": "integer",
            "title": "Quarantine Total"
          }
        },
        "type": "object",
        "required": [
          "orders_by_status",
          "outbox_pending",
          "outbox_scheduled",
          "retries_scheduled",
          "quarantine_total"
        ],
        "title": "AdminSummary"
      },
      "CheckoutItem": {
        "properties": {
          "menu_item_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Menu Item Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "menu_item_id",
          "quantity"
        ],
        "title": "CheckoutItem"
      },
      "CheckoutRequest": {
        "properties": {
          "restaurant_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Restaurant Id"
          },
          "delivery_address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 8,
            "title": "Delivery Address"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CheckoutItem"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "restaurant_id",
          "delivery_address",
          "items"
        ],
        "title": "CheckoutRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
