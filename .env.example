# QuickBite v2 — environment template.
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# All values here are placeholders / safe dev defaults; fictional data only.

# --- Infrastructure ---------------------------------------------------------
# Compose-managed postgres / rabbitmq credentials (used to create the
# containers AND to build the in-compose connection URLs).
POSTGRES_USER=quickbite
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=quickbite
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me-rabbitmq

# Full connection URLs. The defaults in backend/app/config.py point at
# 127.0.0.1 (host-local dev: apt-installed postgres/rabbitmq). Inside
# compose the services override them to the `postgres` / `rabbitmq` hosts
# (see compose.yaml). Override here only if you run services outside compose.
# DATABASE_URL=postgresql+psycopg://quickbite:change-me-postgres@127.0.0.1:5432/quickbite
# AMQP_URL=amqp://guest:change-me-rabbitmq@127.0.0.1:5672/

# Host ports (compose only).
API_PORT=8000
WEB_PORT=8080
MGMT_PORT=15672

# --- Auth -------------------------------------------------------------------
# REQUIRED in prod (QUICKBITE_ENV=prod refuses to start with the dev default).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# --- HTTP -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8080

# --- Reliability tuning -----------------------------------------------------
# 1 initial attempt + 3 delayed retries (~2s / 10s / 30s), then quarantine.
RETRY_DELAYS_S=2,10,30
PREFETCH_COUNT=10
OUTBOX_POLL_INTERVAL_S=0.5
OUTBOX_BATCH_SIZE=50
OUTBOX_CLAIM_LEASE_S=300
RETRY_SCHEDULER_INTERVAL_S=0.5

# --- Deterministic failure simulation (dev/test/demo ONLY) ------------------
# Payment: succeed | fail-twice-then-succeed | always-fail |
#          crash-after-checkpoint | random
PAYMENT_SIM_MODE=succeed
# Crash injection point for crash-after-checkpoint: before-tx | after-commit | before-ack
PAYMENT_CRASH_POINT=after-commit
# Restaurant / delivery / notification: off | always-fail
RESTAURANT_FAIL_MODE=off
DELIVERY_FAIL_MODE=off
NOTIFICATION_FAIL_MODE=off
# Optional artificial per-stage delays (seconds) for load demos.
SIM_PAYMENT_DELAY_S=0.0
SIM_RESTAURANT_DELAY_S=0.0
SIM_DELIVERY_DELAY_S=0.0

# --- Topology overrides (rarely needed; defaults are assignment-mandated) --
# EXCHANGE_NAME=quickbite.orders
# DEAD_EXCHANGE_NAME=quickbite.dead
# DEAD_LETTER_QUEUE=orders.dead-letter.queue
# PAYMENT_QUEUE=payment.queue
# RESTAURANT_QUEUE=restaurant.queue
# DELIVERY_QUEUE=delivery.queue
# NOTIFICATION_QUEUE=notification.queue

# --- Environment marker -----------------------------------------------------
# dev (default) | prod. prod refuses the insecure default JWT_SECRET.
QUICKBITE_ENV=dev
